# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real keys.

# ── IBM watsonx.ai — scene parsing ───────────────────────────
# API key from IBM Cloud IAM (used to fetch a short-lived access token)
WATSONX_API_KEY=your-ibm-cloud-api-key

# watsonx.ai project ID (from the project settings page)
WATSONX_PROJECT_ID=your-project-id

# Regional inference endpoint
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Model to use for text generation
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# ── OpenAI — image generation only ───────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=medium
